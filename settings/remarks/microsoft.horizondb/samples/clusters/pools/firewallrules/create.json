{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "clusterName": {
      "type": "string",
      "defaultValue": "example-cluster",
      "metadata": {
        "description": "The name of the HorizonDB cluster"
      }
    },
    "poolName": {
      "type": "string",
      "defaultValue": "example-pool-01",
      "metadata": {
        "description": "The name of the HorizonDB pool"
      }
    },
    "firewallRuleName": {
      "type": "string",
      "defaultValue": "example-firewall-rule-01",
      "metadata": {
        "description": "The name of the firewall rule"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.HorizonDb/clusters/pools/firewallRules",
      "apiVersion": "2026-10-01-preview",
      "name": "[format('{0}/{1}/{2}', parameters('clusterName'), parameters('poolName'), parameters('firewallRuleName'))]",
      "properties": {
        "startIpAddress": "10.0.0.1",
        "endIpAddress": "10.0.0.254",
        "description": "Allow access from the corporate network"
      }
    }
  ]
}
