{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "clusterName": {
      "type": "string",
      "defaultValue": "example-cluster",
      "metadata": {
        "description": "The name of the HorizonDB cluster"
      }
    },
    "poolName": {
      "type": "string",
      "defaultValue": "example-pool-01",
      "metadata": {
        "description": "The name of the HorizonDB pool"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.HorizonDb/clusters/pools",
      "apiVersion": "2026-10-01-preview",
      "name": "[format('{0}/{1}', parameters('clusterName'), parameters('poolName'))]",
      "properties": {
        "computeModel": {
          "type": "Provisioned",
          "computeProcessor": "AMD",
          "computeGeneration": 3,
          "vCores": 2
        },
        "parameterGroup": {
          "parameterGroupResourceId": "/subscriptions/ffffffff-ffff-ffff-ffff-ffffffffffff/providers/Microsoft.HorizonDb/locations/eastus2/parameterGroups/default-postgresql-17-provisioned",
          "applyMethod": "Immediate"
        },
        "scheduledMaintenance": {
          "maintenanceManagementType": "System"
        },
        "nodeCount": 1,
        "highAvailability": {
          "mode": "Disabled"
        }
      }
    }
  ]
}
