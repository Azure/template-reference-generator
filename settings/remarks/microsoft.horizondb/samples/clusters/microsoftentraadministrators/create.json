{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "clusterName": {
      "type": "string",
      "defaultValue": "example-cluster",
      "metadata": {
        "description": "The name of the HorizonDB cluster"
      }
    },
    "objectId": {
      "type": "string",
      "defaultValue": "11111111-1111-1111-1111-111111111111",
      "metadata": {
        "description": "The object ID of the Microsoft Entra administrator"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.HorizonDb/clusters/microsoftEntraAdministrators",
      "apiVersion": "2026-10-01-preview",
      "name": "[format('{0}/{1}', parameters('clusterName'), parameters('objectId'))]",
      "properties": {
        "principalName": "database.administrators@contoso.com",
        "principalType": "Group",
        "tenantId": "22222222-2222-2222-2222-222222222222"
      }
    }
  ]
}
