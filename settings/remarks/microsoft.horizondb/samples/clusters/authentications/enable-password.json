{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "clusterName": {
      "type": "string",
      "defaultValue": "example-cluster",
      "metadata": {
        "description": "The name of the HorizonDB cluster"
      }
    },
    "administratorLoginPassword": {
      "type": "secureString",
      "metadata": {
        "description": "The administrator login password"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.HorizonDb/clusters/authentications",
      "apiVersion": "2026-10-01-preview",
      "name": "[format('{0}/{1}', parameters('clusterName'), 'passwordMethod')]",
      "properties": {
        "state": "Enabled",
        "administratorLogin": "adminlogin1",
        "administratorLoginPassword": "[parameters('administratorLoginPassword')]"
      }
    }
  ]
}
